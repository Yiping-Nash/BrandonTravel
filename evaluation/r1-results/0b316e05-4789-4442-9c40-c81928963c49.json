  "proposedResult": {
    "summary": "按偏好（连续步行≤30分钟、坐下休息、少台阶、便捷卫生间）筛出两个室内候选：上海博物馆人民广场馆、上海海洋水族馆，均已核对官网服务页；台阶与无障碍细节无来源处标注未知。",
    "candidates": [
      {
        "title": "上海博物馆（人民广场馆）",
        "rationale": "全程室内、扶梯齐全、卫生间密集，契合少步行与便捷如厕需求。",
        "preferenceMatches": [
          "室内动线可控制连续步行时长",
          "各层有卫生间，1楼标注无障碍措施",
          "茶室、餐厅、服务台可坐下休息"
        ],
        "tradeoffs": [
          "台阶/坡道细节官网未逐项说明",
          "高峰需预约，余票未核验"
        ],
        "claims": [
          {
            "text": "官网服务页列出“无障碍服务”和“婴儿车、轮椅”服务项目，1楼设施表含“无障碍措施”，各楼层均有男/女卫生间。",
            "kind": "fact",
            "evidenceRefs": [
              "ev:0a0600da64808971411abf7f"
            ]
          },
          {
            "text": "官网：除国定假日外每周一闭馆，9:00–17:00，16:00后停止入场；双休日、节假日及参观高峰需预约入馆；建议从南门（近武胜路）入馆。",
            "kind": "fact",
            "evidenceRefs": [
              "ev:0a0600da64808971411abf7f"
            ]
          },
          {
            "text": "室内恒温、地铁1/2/8号线人民广场站直达、馆内有茶室与餐厅，适合分楼层短时段参观并坐下休息。",
            "kind": "inference",
            "evidenceRefs": [
              "ev:0a0600da64808971411abf7f"
            ]
          }
        ],
        "proposedDate": "2026-11-04 或 2026-11-05（避开周一闭馆）",
        "placeEvidenceRef": "ev:66c28aa3b7b0adf7c852c782"
      },
      {
        "title": "上海海洋水族馆（陆家嘴）",
        "rationale": "可现场租轮椅推行参观，每层有洗手间，距陆家嘴地铁站近。",
        "preferenceMatches": [
          "馆内可免费租轮椅，显著减少步行",
          "每层设洗手间，如厕便捷",
          "室内参观，可慢速行进随时停靠"
        ],
        "tradeoffs": [
          "官网未列电梯/扶梯分布，垂直交通未知",
          "轮椅不可推出场馆，出入口仍需步行"
        ],
        "claims": [
          {
            "text": "官网服务设施页：提供婴儿车和轮椅馆内免费租用，轮椅押金800元、归还即退；仅限馆内使用，当日营业时间内归还。",
            "kind": "fact",
            "evidenceRefs": [
