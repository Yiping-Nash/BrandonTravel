# Fill secrets locally. Never paste keys into chat or commit .env.
# Alibaba Cloud Model Studio / DashScope (region must match key)
DASHSCOPE_API_KEY=
AGENT_MODEL=qwen3.8-flash
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Explicit demo/real selection is per chat request. No silent mock fallback.
# AMap console: create a Web Service key for server-side POI search
AMAP_WEB_SERVICE_KEY=
# LangSmith Settings > API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=BrandonTravel2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional workspace ID if your LangSmith key belongs to multiple workspaces
LANGSMITH_WORKSPACE_ID=
DATABASE_PATH=data/brandontravel.sqlite3
# R1 web search/extraction. Fill locally at https://app.tavily.com
TAVILY_API_KEY=
# Optional outbound proxy for LangSmith/Tavily only (never exposed to browser)
RESEARCH_HTTPS_PROXY=
# Optional actual model pricing; blank means unknown, not free.
QWEN_INPUT_CNY_PER_MILLION=
QWEN_OUTPUT_CNY_PER_MILLION=
# R1 candidate-model configuration. These do not change the accepted app model.
# Qwen Plus uses the existing DASHSCOPE_API_KEY and matching AGENT_BASE_URL.
QWEN_COMPARISON_MODEL=qwen3.7-plus
# One official DeepSeek key serves both candidate models.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FLASH_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Portfolio blueprint / day proposals / Research use the same official adapter profile.
# Chat retains AGENT_MODEL above. No silent fallback between providers.
PORTFOLIO_MODEL=deepseek-flash
# High-cost reference; native Anthropic API, not an OpenAI-compatible endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_REFERENCE_MODEL=claude-sonnet-5-5
