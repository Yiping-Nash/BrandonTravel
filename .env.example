# Fill secrets locally. Never paste keys into chat or commit .env.
# Alibaba Cloud Model Studio / DashScope (region must match key)
DASHSCOPE_API_KEY=
AGENT_MODEL=qwen3.8-flash
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Explicit demo/real selection is per chat request. No silent mock fallback.
# AMap console: create a Web Service key for server-side POI search
AMAP_WEB_SERVICE_KEY=
# LangSmith Settings > API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=BrandonTravel2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional workspace ID if your LangSmith key belongs to multiple workspaces
LANGSMITH_WORKSPACE_ID=
DATABASE_PATH=data/brandontravel.sqlite3
