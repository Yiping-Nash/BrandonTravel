      "import": "./src/errors.ts",
      "types": "./src/errors.ts"
    },
    "./api-key": {
      "import": "./src/api-key.ts",
      "types": "./src/api-key.ts"
    },
    "./constants": {
      "import": "./src/constants.ts",
